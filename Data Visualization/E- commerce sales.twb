      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0nbfo6002shdis18t5qob03gulbo].[cnt:order_id:qk]&quot;' value='Total Order' />
          <alias key='&quot;[federated.0nbfo6002shdis18t5qob03gulbo].[sum:cost:qk]&quot;' value='Total Cost' />
          <alias key='&quot;[federated.0nbfo6002shdis18t5qob03gulbo].[sum:profit:qk]&quot;' value='Total Profit' />
          <alias key='&quot;[federated.0nbfo6002shdis18t5qob03gulbo].[sum:revenue:qk]&quot;' value='Total Revenue' />
          <alias key='&quot;[federated.0nbfo6002shdis18t5qob03gulbo].[usr:Calculation_1235081713627140:qk]&quot;' value='Overall Profit Margin' />
        </aliases>
      </column>
      <column caption='Trend metric' datatype='real' name='[Calculation_1235081707438082]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1235081706704897]&#13;&#10;    WHEN &quot;Revenue&quot; THEN SUM([revenue])&#13;&#10;    WHEN &quot;Profit&quot; THEN SUM([profit])&#13;&#10;    WHEN &quot;Quantity&quot; THEN SUM([quantity])&#13;&#10;    WHEN &quot;Order Id&quot; THEN COUNT([order_id])&#13;&#10;END' />
      </column>
      <column caption='Profit Margin' datatype='real' name='[Calculation_1235081713627140]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([profit])/SUM([revenue])' />
      </column>
      <column caption='Discount Band' datatype='string' name='[Calculation_1235081721847817]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [discount_rate] = 0 THEN &apos;No Discount&apos;&#13;&#10;ELSEIF [discount_rate] &lt;= 0.05 THEN &apos;Low (≤5%)&apos;&#13;&#10;ELSEIF [discount_rate] &lt;= 0.10 THEN &apos;Medium (6–10%)&apos;&#13;&#10;ELSEIF [discount_rate] &lt;= 0.15 THEN &apos;High (11–15%)&apos;&#13;&#10;ELSE &apos;Very High (&gt;15%)&apos;&#13;&#10;END' />
      </column>
      <column caption='AOV' datatype='real' name='[Calculation_1235081722220554]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([revenue]) / COUNTD([order_id])' />
      </column>
      <column caption='Completed Rate' datatype='real' name='[Calculation_1235081722359819]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [order_status] = &apos;Completed&apos; THEN [order_id] END) / COUNTD([order_id])' />
      </column>
      <column caption='Order Outcome' datatype='string' name='[Calculation_1235082046746638]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [order_status] = &apos;Completed&apos; THEN &apos;Completed&apos; ELSE &apos;Leakage&apos; END' />
      </column>
      <column caption='Order Month' datatype='datetime' name='[Calculation_1235082046918671]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [order_date])' />
      </column>
      <column caption='Profit Status' datatype='string' name='[Calculation_1235082047250448]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [profit] &lt; 0 THEN &apos;Loss&apos; ELSE &apos;Profit&apos; END' />
      </column>
      <column caption='Total Orders' datatype='integer' name='[Calculation_1235082047451153]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([order_id])' />
      </column>
