    <worksheet name='discount vs profit margin'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#0f1115' fontname='quote-cjk-patch,Inter,system-ui,-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Oxygen,Ubuntu,Cantarell,Open Sans,Helvetica Neue,sans-serif' fontsize='12'>Discount Band vs Average Profit Margin</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Tabular_cleaned' name='federated.0nbfo6002shdis18t5qob03gulbo' />
          </datasources>
          <datasource-dependencies datasource='federated.0nbfo6002shdis18t5qob03gulbo'>
            <column caption='Profit Margin' datatype='real' name='[Calculation_1235081713627140]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([profit])/SUM([revenue])' />
            </column>
            <column caption='Discount Band' datatype='string' name='[Calculation_1235081721847817]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [discount_rate] = 0 THEN &apos;No Discount&apos;&#13;&#10;ELSEIF [discount_rate] &lt;= 0.05 THEN &apos;Low (≤5%)&apos;&#13;&#10;ELSEIF [discount_rate] &lt;= 0.10 THEN &apos;Medium (6–10%)&apos;&#13;&#10;ELSEIF [discount_rate] &lt;= 0.15 THEN &apos;High (11–15%)&apos;&#13;&#10;ELSE &apos;Very High (&gt;15%)&apos;&#13;&#10;END' />
            </column>
            <column caption='Discount Rate' datatype='real' name='[discount_rate]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1235081721847817]' derivation='None' name='[none:Calculation_1235081721847817:nk]' pivot='key' type='nominal' />
            <column caption='Profit' datatype='real' name='[profit]' role='measure' type='quantitative' />
            <column caption='Revenue' datatype='integer' name='[revenue]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1235081713627140]' derivation='User' name='[usr:Calculation_1235081713627140:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <manual-sort column='[federated.0nbfo6002shdis18t5qob03gulbo].[none:Calculation_1235081721847817:nk]' direction='ASC'>
            <dictionary>
              <bucket>&quot;No Discount&quot;</bucket>
              <bucket>&quot;Low (≤5\%)&quot;</bucket>
              <bucket>&quot;Medium (6–10\%)&quot;</bucket>
              <bucket>&quot;High (11–15\%)&quot;</bucket>
              <bucket>&quot;Very High (&gt;15\%)&quot;</bucket>
              <bucket>%all%</bucket>
            </dictionary>
          </manual-sort>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='mark'>
